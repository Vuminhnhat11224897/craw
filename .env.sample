# Copy to craw_real_times/.env and replace these two values before starting.
INTERNAL_API_KEY=replace-with-a-long-random-key
ARTICLE_UUIDV5_NAMESPACE=replace-with-the-uuid-used-by-crawl_lastest_news

# Required only when a request sets save_to_db=true.
DATABASE_URL=
DB_APPLICATION_NAME=realtime-news-crawler

RECORD_TIMEZONE=Asia/Ho_Chi_Minh
MAX_CONCURRENT_CRAWLS=8
CRAWL_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=3
READ_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=1
MAX_HTML_BYTES=5242880
MAX_IMAGE_BYTES=20971520
MAX_VIDEOS_PER_ARTICLE=5
IMAGES_FOLDER=./realtime_images
BLOCKED_IMAGE_URLS=https://bqn.1cdn.vn/assets/images/grey.gif

HTTP_USER_AGENT=Mozilla/5.0 (compatible; RealtimeNewsCrawler/1.0)
HTTP_ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
HTTP_JSON_ACCEPT=application/json
HTTP_IMAGE_ACCEPT=image/*,*/*;q=0.8
HTTP_ACCEPT_LANGUAGE=vi-VN,vi;q=0.9,en-US;q=0.8,en;q=0.7
DEFAULT_DOMAIN_DELAY_SECONDS=0.5
HTTP_MAX_REDIRECTS=6
HTTP_CHUNK_BYTES=4096
RETRY_BACKOFF_CAP_SECONDS=1
RETRY_AFTER_SECONDS=1
MOHA_API_BASE=https://api-portal.moha.gov.vn/api/Public
MOF_API_BASE=https://www.mof.gov.vn/api

# API listener and Docker Compose settings. Keep one worker because crawl
# limits and per-domain pacing are process-local.
REALTIME_LISTEN_HOST=127.0.0.1
REALTIME_LISTEN_PORT=8000
REALTIME_WORKERS=1
REALTIME_CONTAINER_LISTEN_HOST=0.0.0.0
REALTIME_CONTAINER_IMAGES_FOLDER=/app/realtime_images
REALTIME_BIND_ADDRESS=127.0.0.1
REALTIME_HOST_PORT=8000
PYTHON_VERSION=3.11
